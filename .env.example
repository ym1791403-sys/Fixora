# ==============================================================================
# ByteForce Production Environment Variables
# ==============================================================================
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية من لوحة Supabase.
# لا تضع مفاتيح حقيقية أبداً في هذا الملف ولا في الكود.

# Supabase Production Project Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PROJECT_REF=<your-project-ref>

# Supabase Anonymous Publishable Key (used by client-side browser & public endpoints)
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_KEY=<your-anon-key>

# Supabase Service Role Key (used ONLY by server-side backend ingestion scripts & secure admin operations)
# NEVER expose this key to client-side bundles or frontend code
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Supabase Management API Token (used for programmatic DDL migrations)
SUPABASE_MGMT_TOKEN=<your-management-token>

# AI Model Integration (Supply ANY ONE key below to enable LLM deep hardware reasoning)
# GEMINI_API_KEY=<your-gemini-key>
# OPENAI_API_KEY=<your-openai-key>
# GROQ_API_KEY=<your-groq-key>
# OPENROUTER_API_KEY=<your-openrouter-key>

# Server Configuration
PORT=8000
ENVIRONMENT=production
